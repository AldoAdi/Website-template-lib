    "jsdom": "^30.0.1",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0",
    "zod": "^4.5.4"
